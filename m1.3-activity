<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>When AI Gets It Wrong – Learning Activity</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  /* ── Token System ──────────────────────────────────────── */
  :root {
    --purple-dark:  #3D1F8F;
    --purple-mid:   #6B3FC0;
    --purple-light: #9B6FE8;
    --purple-tint:  #F0EAFF;
    --purple-pale:  #F8F5FF;
    --amber:        #F59E0B;
    --amber-tint:   #FFFBEB;
    --teal:         #0D9488;
    --teal-tint:    #F0FDFA;
    --red:          #DC2626;
    --red-tint:     #FEF2F2;
    --green:        #16A34A;
    --green-tint:   #F0FDF4;
    --ink:          #1A1035;
    --ink-soft:     #4B4568;
    --border:       #E8E0F8;
    --white:        #FFFFFF;
    --radius-card:  16px;
    --radius-pill:  100px;
    --shadow-card:  0 2px 16px rgba(61,31,143,0.10);
    --shadow-hover: 0 6px 28px rgba(61,31,143,0.18);
  }

  /* ── Reset ─────────────────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'DM Sans', sans-serif;
    background: #FAFAFA;
    color: var(--ink);
    line-height: 1.6;
    min-height: 100vh;
  }

  /* ── Page Shell ────────────────────────────────────────── */
  .page {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 20px 80px;
  }

  /* ── Hero Banner ────────────────────────────────────────── */
  .hero {
    background: linear-gradient(135deg, var(--purple-dark) 0%, var(--purple-mid) 100%);
    border-radius: 0 0 32px 32px;
    padding: 48px 40px 44px;
    margin-bottom: 40px;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: -40px; right: -40px;
    width: 220px; height: 220px;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    pointer-events: none;
  }
  .hero::after {
    content: '';
    position: absolute;
    bottom: -60px; left: 40px;
    width: 160px; height: 160px;
    border-radius: 50%;
    background: rgba(255,255,255,0.04);
    pointer-events: none;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: var(--radius-pill);
    color: #fff;
    font-family: 'Sora', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 14px;
    margin-bottom: 18px;
  }
  .hero h1 {
    font-family: 'Sora', sans-serif;
    font-size: clamp(26px, 5vw, 38px);
    font-weight: 800;
    color: #fff;
    line-height: 1.15;
    margin-bottom: 14px;
    position: relative;
    z-index: 1;
  }
  .hero h1 span {
    color: #C4ABFF;
  }
  .hero-mission {
    font-size: 16px;
    color: rgba(255,255,255,0.85);
    max-width: 560px;
    position: relative;
    z-index: 1;
    font-weight: 500;
  }

  /* ── Section label ──────────────────────────────────────── */
  .section-label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Sora', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--purple-mid);
    margin-bottom: 14px;
  }
  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  /* ── Cards ──────────────────────────────────────────────── */
  .card {
    background: var(--white);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    border: 1px solid var(--border);
    padding: 28px 32px;
    margin-bottom: 24px;
  }
  .card-title {
    font-family: 'Sora', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Scenario card */
  .card-scenario {
    background: var(--purple-pale);
    border: 1.5px solid #D4C4F8;
  }
  .card-scenario .card-title { color: var(--purple-dark); }

  .scenario-body {
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-soft);
  }
  .scenario-body strong { color: var(--ink); }

  /* AI card */
  .card-ai {
    background: var(--amber-tint);
    border: 1.5px solid #FCD34D;
  }
  .card-ai .card-title { color: #92400E; }

  .ai-alert {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: #FEF3C7;
    border: 1px solid #FCD34D;
    border-radius: 10px;
    padding: 16px 20px;
    margin-bottom: 14px;
  }
  .ai-alert-icon { font-size: 28px; flex-shrink: 0; }
  .ai-alert-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #B45309;
    margin-bottom: 4px;
  }
  .ai-alert-text {
    font-size: 15px;
    font-weight: 600;
    color: #78350F;
  }

  .ai-readings {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 10px;
    margin-top: 14px;
  }
  .reading-chip {
    background: #fff;
    border: 1px solid #FCD34D;
    border-radius: 8px;
    padding: 10px 14px;
    text-align: center;
  }
  .reading-chip .value {
    font-family: 'Sora', sans-serif;
    font-size: 22px;
    font-weight: 800;
    color: #D97706;
  }
  .reading-chip .label {
    font-size: 11px;
    color: #92400E;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Human card */
  .card-human {
    background: var(--teal-tint);
    border: 1.5px solid #99F6E4;
  }
  .card-human .card-title { color: #115E59; }

  .human-obs-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
  }
  .human-obs-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    color: var(--ink-soft);
    background: rgba(255,255,255,0.7);
    border-radius: 8px;
    padding: 10px 14px;
    border: 1px solid #CCFBF1;
  }
  .human-obs-list li .obs-icon { font-size: 18px; flex-shrink: 0; margin-top: 1px; }

  /* ── Investigation Activity ────────────────────────────── */
  .investigation-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 8px;
  }
  @media (max-width: 580px) { .investigation-grid { grid-template-columns: 1fr; } }

  .inv-column-label {
    font-family: 'Sora', sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 8px 12px;
    border-radius: 8px 8px 0 0;
    text-align: center;
  }
  .inv-column-label.ai   { background: #FEF3C7; color: #92400E; }
  .inv-column-label.human{ background: #CCFBF1; color: #115E59; }

  .inv-column {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 0 0 12px 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .check-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
    padding: 10px 12px;
    border-radius: 8px;
    border: 2px solid transparent;
    transition: border-color 0.2s, background 0.2s;
    user-select: none;
  }
  .check-item:hover { background: var(--purple-tint); border-color: var(--purple-light); }
  .check-item input[type="checkbox"] {
    width: 18px; height: 18px;
    accent-color: var(--purple-mid);
    flex-shrink: 0;
    margin-top: 2px;
    cursor: pointer;
  }
  .check-item label {
    font-size: 14px;
    color: var(--ink-soft);
    cursor: pointer;
    line-height: 1.5;
  }
  .check-item.selected {
    background: var(--purple-tint);
    border-color: var(--purple-mid);
  }
  .check-item.selected label { color: var(--ink); font-weight: 600; }

  .inv-prompt {
    font-size: 14px;
    font-weight: 600;
    color: var(--purple-dark);
    background: var(--purple-tint);
    border-radius: 10px;
    padding: 10px 14px;
    margin-bottom: 8px;
    text-align: center;
  }

  /* ── Decision Activity ─────────────────────────────────── */
  .decision-options {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
  }

  .decision-btn {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 18px 20px;
    background: var(--white);
    border: 2px solid var(--border);
    border-radius: 12px;
    cursor: pointer;
    text-align: left;
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    width: 100%;
    font-family: 'DM Sans', sans-serif;
    position: relative;
  }
  .decision-btn:hover {
    border-color: var(--purple-light);
    box-shadow: var(--shadow-hover);
    background: var(--purple-pale);
  }
  .decision-btn.selected-wrong {
    border-color: var(--red);
    background: var(--red-tint);
  }
  .decision-btn.selected-right {
    border-color: var(--green);
    background: var(--green-tint);
  }
  .decision-btn .option-letter {
    width: 32px; height: 32px;
    border-radius: 50%;
    background: var(--purple-tint);
    color: var(--purple-dark);
    font-family: 'Sora', sans-serif;
    font-size: 13px;
    font-weight: 800;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .decision-btn .option-text {
    font-size: 15px;
    color: var(--ink-soft);
    line-height: 1.5;
    flex: 1;
  }
  .decision-btn .option-text strong { display: block; color: var(--ink); font-size: 15px; margin-bottom: 2px; }
  .feedback-badge {
    display: none;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    border-radius: var(--radius-pill);
    padding: 4px 12px;
    margin-top: 8px;
  }
  .decision-btn.selected-wrong .feedback-badge {
    display: inline-flex;
    background: var(--red-tint);
    color: var(--red);
    border: 1px solid #FECACA;
  }
  .decision-btn.selected-right .feedback-badge {
    display: inline-flex;
    background: var(--green-tint);
    color: var(--green);
    border: 1px solid #BBF7D0;
  }
  .feedback-msg {
    display: none;
    margin-top: 16px;
    padding: 16px 20px;
    border-radius: 12px;
    font-size: 14px;
    line-height: 1.6;
  }
  .feedback-msg.show { display: block; }
  .feedback-msg.wrong {
    background: var(--red-tint);
    border: 1px solid #FECACA;
    color: #7F1D1D;
  }
  .feedback-msg.right {
    background: var(--green-tint);
    border: 1px solid #BBF7D0;
    color: #14532D;
  }

  /* ── Reflection ────────────────────────────────────────── */
  .reflection-card {
    background: linear-gradient(135deg, #EDE9FE 0%, #F0EAFF 100%);
    border: 1.5px solid #C4B5FD;
    border-radius: var(--radius-card);
    padding: 32px;
    margin-bottom: 24px;
  }
  .reflection-q {
    font-family: 'Sora', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--purple-dark);
    margin-bottom: 16px;
    line-height: 1.4;
  }
  .reflection-textarea {
    width: 100%;
    min-height: 100px;
    border: 2px solid #C4B5FD;
    border-radius: 10px;
    padding: 14px 16px;
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    color: var(--ink);
    resize: vertical;
    background: rgba(255,255,255,0.85);
    outline: none;
    transition: border-color 0.2s;
  }
  .reflection-textarea:focus { border-color: var(--purple-mid); }
  .reflection-textarea::placeholder { color: #A78BDA; }
  .char-hint {
    font-size: 12px;
    color: var(--purple-light);
    margin-top: 8px;
    text-align: right;
  }

  /* ── Key Takeaway ──────────────────────────────────────── */
  .takeaway-strip {
    background: var(--purple-dark);
    border-radius: var(--radius-card);
    padding: 28px 32px;
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }
  .takeaway-icon { font-size: 36px; flex-shrink: 0; }
  .takeaway-body h3 {
    font-family: 'Sora', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #C4ABFF;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 8px;
  }
  .takeaway-body p {
    font-size: 15px;
    color: rgba(255,255,255,0.88);
    line-height: 1.6;
  }

  /* ── Utility ────────────────────────────────────────────── */
  .spacer-sm { height: 12px; }
  .spacer-md { height: 32px; }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
  }
  .badge-purple { background: var(--purple-tint); color: var(--purple-dark); border: 1px solid #C4B5FD; }
  .badge-amber  { background: #FEF3C7; color: #92400E; border: 1px solid #FCD34D; }
  .badge-teal   { background: #CCFBF1; color: #115E59; border: 1px solid #99F6E4; }

  @media (max-width: 600px) {
    .hero { padding: 36px 24px 32px; }
    .card { padding: 22px 20px; }
    .ai-readings { grid-template-columns: repeat(2, 1fr); }
    .takeaway-strip { flex-direction: column; gap: 12px; }
  }
</style>
</head>
<body>

<!-- ══ HERO ═════════════════════════════════════════════════ -->
<div class="hero">
  <div class="hero-eyebrow">🏭 Workplace Activity</div>
  <h1>When AI Gets<br><span>It Wrong</span></h1>
  <p class="hero-mission">
    Your mission: Review what the AI flagged — then decide what a smart manufacturing team would actually do next.
  </p>
</div>

<div class="page">

  <!-- ══ SCENARIO ════════════════════════════════════════════ -->
  <div class="section-label">📋 Step 1 — The Situation</div>
  <div class="card card-scenario">
    <div class="card-title">🏭 Your Workplace Scenario</div>
    <p class="scenario-body">
      You work at <strong>Ridgeline Metal Products</strong>, a factory that makes steel parts for trucks and farm equipment.
      Your shift started at 6 AM. At 7:15 AM, the AI monitoring system sends an alert about <strong>Machine #4</strong> — a large press used for cutting steel sheets.
    </p>
    <p class="scenario-body" style="margin-top:10px;">
      The system says Machine #4 is running too hot and recommends <strong>an immediate shutdown</strong>.
      But your lead operator, Marcus, walked past that machine 10 minutes ago and noticed nothing unusual.
    </p>
    <div class="badge-row">
      <span class="badge badge-purple">🕖 7:15 AM Alert</span>
      <span class="badge badge-amber">⚠️ Shutdown Recommended</span>
      <span class="badge badge-teal">👷 Marcus saw nothing wrong</span>
    </div>
  </div>

  <div class="spacer-md"></div>

  <!-- ══ TWO-COLUMN: AI vs HUMAN ═══════════════════════════ -->
  <div class="section-label">🔍 Step 2 — Two Different Views</div>

  <!-- AI CARD -->
  <div class="card card-ai">
    <div class="card-title">🤖 What the AI System Is Seeing</div>
    <div class="ai-alert">
      <div class="ai-alert-icon">🔴</div>
      <div>
        <div class="ai-alert-label">System Alert — Machine #4</div>
        <div class="ai-alert-text">"Temperature reading exceeds safe threshold. Recommend immediate shutdown to prevent equipment damage."</div>
      </div>
    </div>
    <div class="ai-readings">
      <div class="reading-chip">
        <div class="value">218°F</div>
        <div class="label">Current Temp</div>
      </div>
      <div class="reading-chip">
        <div class="value">195°F</div>
        <div class="label">Normal Range</div>
      </div>
      <div class="reading-chip">
        <div class="value">+23°</div>
        <div class="label">Above Baseline</div>
      </div>
      <div class="reading-chip">
        <div class="value">🕖 3 min</div>
        <div class="label">Alert Duration</div>
      </div>
    </div>
  </div>

  <!-- HUMAN CARD -->
  <div class="card card-human">
    <div class="card-title">👷 What Your Team Is Observing</div>
    <ul class="human-obs-list">
      <li><span class="obs-icon">🌡️</span> Maintenance ran a scheduled heat calibration test on Machine #4 at 6:50 AM this morning.</li>
      <li><span class="obs-icon">📋</span> The calibration is on the work order log — but the AI system may not have received that update.</li>
      <li><span class="obs-icon">👁️</span> Marcus visually checked the machine at 7:05 AM. No smoke, no unusual sounds, no visible issues.</li>
      <li><span class="obs-icon">🔧</span> The machine has run clean for 3 weeks with zero maintenance flags.</li>
      <li><span class="obs-icon">📡</span> Sensor #4-B has had two false readings in the past month.</li>
    </ul>
  </div>

  <div class="spacer-md"></div>

  <!-- ══ INVESTIGATION ════════════════════════════════════════ -->
  <div class="section-label">🧠 Step 3 — Think It Through</div>
  <div class="card" style="padding-bottom:24px;">
    <div class="card-title" style="color:var(--purple-dark);">🧩 Sort the Evidence</div>
    <p class="inv-prompt">Check every item that makes you want to trust or question the AI alert.</p>
    <div class="investigation-grid">
      <div>
        <div class="inv-column-label ai">🤖 Supports the AI Alert</div>
        <div class="inv-column" id="col-ai">
          <!-- checkboxes populated by JS -->
        </div>
      </div>
      <div>
        <div class="inv-column-label human">👷 Questions the AI Alert</div>
        <div class="inv-column" id="col-human">
        </div>
      </div>
    </div>
    <p style="font-size:13px;color:var(--ink-soft);margin-top:16px;text-align:center;">
      💡 <em>There are no wrong answers here. The goal is to think like an investigator.</em>
    </p>
  </div>

  <div class="spacer-md"></div>

  <!-- ══ DECISION ═════════════════════════════════════════════ -->
  <div class="section-label">🎯 Step 4 — Make the Call</div>
  <div class="card">
    <div class="card-title" style="color:var(--purple-dark);">🎯 What Should the Team Do?</div>
    <p style="font-size:15px;color:var(--ink-soft);margin-bottom:18px;">
      Choose the option that best shows strong human-AI teamwork.
    </p>
    <div class="decision-options" id="decision-options">

      <button class="decision-btn" data-correct="false" data-msg="Shutting down right away without investigation treats the AI alert as certain truth. But the alert may be caused by a sensor glitch or the calibration test — not a real problem. A knee-jerk shutdown wastes time and stops production unnecessarily." onclick="selectDecision(this)">
        <div class="option-letter">A</div>
        <div class="option-text">
          <strong>Shut down Machine #4 immediately.</strong>
          The AI alert is serious. Don't take any chances.
          <div class="feedback-badge">✗ Not the best choice</div>
        </div>
      </button>

      <button class="decision-btn" data-correct="false" data-msg="Ignoring the alert completely is also risky. Even if the reading looks like a false alarm, workers should never fully dismiss a safety alert without at least a quick check." onclick="selectDecision(this)">
        <div class="option-letter">B</div>
        <div class="option-text">
          <strong>Ignore the alert and keep running.</strong>
          Marcus already looked at it — it's fine.
          <div class="feedback-badge">✗ Not the best choice</div>
        </div>
      </button>

      <button class="decision-btn" data-correct="true" data-msg="Great thinking! This is exactly what strong human-AI teamwork looks like. You're not ignoring the AI — you're verifying it. You checked the maintenance log, inspected the machine, and confirmed whether the alert makes sense before acting. That's responsible decision-making." onclick="selectDecision(this)">
        <div class="option-letter">C</div>
        <div class="option-text">
          <strong>Pause and verify before acting.</strong>
          Pull the maintenance log, check the sensor history, have Marcus do a hands-on inspection — then decide.
          <div class="feedback-badge">✓ Strong choice!</div>
        </div>
      </button>

      <button class="decision-btn" data-correct="false" data-msg="Escalating immediately without doing basic checks first adds stress and delays. Your team has enough information on hand to investigate this quickly. Save the supervisor call for after you've gathered the facts." onclick="selectDecision(this)">
        <div class="option-letter">D</div>
        <div class="option-text">
          <strong>Call the supervisor right away.</strong>
          This is above your pay grade — let them decide.
          <div class="feedback-badge">✗ Not the best choice</div>
        </div>
      </button>

    </div>
    <div class="feedback-msg" id="feedback-msg"></div>
  </div>

  <div class="spacer-md"></div>

  <!-- ══ REFLECTION ═══════════════════════════════════════════ -->
  <div class="section-label">💡 Step 5 — Reflect</div>
  <div class="reflection-card">
    <div class="reflection-q">
      💡 Think about this: If Machine #4 had been shut down immediately based on the AI alert alone — what could have gone wrong for the team?
    </div>
    <textarea class="reflection-textarea" placeholder="Write 2–3 sentences. Think about what information would have been missed, and what that could mean for the team and the factory..." maxlength="600" oninput="updateCharCount(this)"></textarea>
    <div class="char-hint" id="char-hint">600 characters remaining</div>
  </div>

  <!-- ══ TAKEAWAY ══════════════════════════════════════════════ -->
  <div class="takeaway-strip">
    <div class="takeaway-icon">🧠</div>
    <div class="takeaway-body">
      <h3>Remember This</h3>
      <p>
        AI systems are powerful tools — but they only see the data they're given. They don't know about the calibration test, Marcus's visual check, or the sensor's history of false readings. <strong style="color:#C4ABFF;">Human workers bring context that machines can't.</strong> Always verify before you act.
      </p>
    </div>
  </div>

</div><!-- /page -->

<script>
  /* ── Investigation checkboxes ─────────────────────────── */
  const aiItems = [
    { id: 'a1', text: 'Temperature is 23° above the normal baseline.' },
    { id: 'a2', text: 'The AI alert has been active for 3 minutes.' },
    { id: 'a3', text: 'The system recommends immediate shutdown.' },
  ];
  const humanItems = [
    { id: 'h1', text: 'Maintenance ran a calibration test at 6:50 AM.' },
    { id: 'h2', text: 'The AI may not have been updated about the test.' },
    { id: 'h3', text: 'Marcus saw no issues at 7:05 AM.' },
    { id: 'h4', text: 'Sensor #4-B had two false readings before.' },
    { id: 'h5', text: 'Machine #4 has been clean for 3 weeks.' },
  ];

  function buildChecklist(containerId, items) {
    const container = document.getElementById(containerId);
    items.forEach(item => {
      const label = document.createElement('label');
      label.className = 'check-item';
      label.innerHTML = `
        <input type="checkbox" id="${item.id}" onchange="toggleCheck(this)">
        <label for="${item.id}">${item.text}</label>
      `;
      container.appendChild(label);
    });
  }

  buildChecklist('col-ai', aiItems);
  buildChecklist('col-human', humanItems);

  function toggleCheck(checkbox) {
    const item = checkbox.closest('.check-item');
    item.classList.toggle('selected', checkbox.checked);
  }

  /* ── Decision activity ─────────────────────────────────── */
  function selectDecision(btn) {
    const buttons = document.querySelectorAll('.decision-btn');
    const feedbackEl = document.getElementById('feedback-msg');

    buttons.forEach(b => {
      b.classList.remove('selected-right', 'selected-wrong');
    });

    const isCorrect = btn.dataset.correct === 'true';
    btn.classList.add(isCorrect ? 'selected-right' : 'selected-wrong');

    feedbackEl.textContent = btn.dataset.msg;
    feedbackEl.className = 'feedback-msg show ' + (isCorrect ? 'right' : 'wrong');
    feedbackEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  /* ── Reflection char count ─────────────────────────────── */
  function updateCharCount(el) {
    const remaining = 600 - el.value.length;
    document.getElementById('char-hint').textContent = remaining + ' characters remaining';
  }
</script>

</body>
</html>
